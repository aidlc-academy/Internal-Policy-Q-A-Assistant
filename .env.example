# Copy this file to .env and fill in your values
# The application will still run without OPENAI_API_KEY
# by falling back to a no-LLM mode that returns retrieved chunks directly.

# --- LLM Provider (choose ONE block) ---

# Option A: OpenAI (recommended for best quality)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini        # or gpt-3.5-turbo, gpt-4o

# Option B: Local Ollama (free, no API cost)
# Set LLM_PROVIDER=ollama and leave OPENAI_API_KEY blank.
# Install: https://ollama.com/  then run: ollama pull mistral
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=mistral
# OLLAMA_BASE_URL=http://localhost:11434

# Option C: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- Embedding model (default: local, no API key needed) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Retrieval settings ---
RETRIEVAL_TOP_K=5
# Threshold calibrated from live data: on-topic questions score 0.74-0.79,
# off-topic questions score 0.66-0.68. 0.72 cleanly separates them.
MIN_RETRIEVAL_SCORE=0.72

# --- ChromaDB ---
CHROMA_DB_PATH=./db
CHROMA_COLLECTION=policy_chunks

# --- Data paths ---
RAW_DIR=data/raw
MANIFEST_PATH=data/manifest.json
